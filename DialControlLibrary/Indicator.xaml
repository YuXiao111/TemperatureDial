<UserControl x:Class="DialControlLibrary.Indicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DialControlLibrary"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Viewbox Stretch="Uniform">
        <Grid Width="110"
              Height="85">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.55*" />
                <RowDefinition Height="0.45*" />
            </Grid.RowDefinitions>
            <Border Grid.RowSpan="2"
                    Background="Transparent" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Label x:Name="DisplayNumber"
                       Content="24"
                       FontSize="24"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Arial"
                       HorizontalContentAlignment="Center"
                       Width="60"
                       Foreground="#419F8D" />
                <Label Content="℃"
                       FontSize="24"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Arial"
                       Foreground="#0070C0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Grid.Row="1">
                <Ellipse Width="25"
                         Height="25"
                         StrokeThickness="2"
                         Stroke="#CFE2F2"
                         x:Name="LowLight" />
                <Ellipse Width="25"
                         Height="25"
                         StrokeThickness="2"
                         Margin="10,0"
                         Stroke="#CFE2F2"
                         x:Name="MidLight" />
                <Ellipse Width="25"
                         Height="25"
                         StrokeThickness="2"
                         Stroke="#CFE2F2"
                         x:Name="SuperLight" />
            </StackPanel>

        </Grid>
    </Viewbox>
</UserControl>
