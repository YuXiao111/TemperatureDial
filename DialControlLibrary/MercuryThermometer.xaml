<UserControl x:Class="DialControlLibrary.MercuryThermometer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DialControlLibrary"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Viewbox Stretch="Uniform">
        <Grid Width="110"
              Height="224">
            <Border CornerRadius="8">
                <Border.Background>
                    <LinearGradientBrush>
                        <GradientStop Color="#419f80"
                                      Offset="0.499" />
                        <GradientStop Color="#46B09A"
                                      Offset="0.50" />
                        <LinearGradientBrush.Transform>
                            <RotateTransform CenterX="55"
                                             CenterY="112"
                                             Angle="272" />
                        </LinearGradientBrush.Transform>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Canvas>
                <Ellipse Width="20"
                         Height="20"
                         Fill="White"
                         Canvas.Left="45"
                         Canvas.Top="10" />
                <Ellipse Width="10"
                         Height="10"
                         Fill="#46B09A"
                         Canvas.Left="50"
                         Canvas.Top="15" />
                <Rectangle Width="80"
                           Height="190"
                           Fill="#EAE4B8"
                           RadiusX="8"
                           RadiusY="8"
                           Canvas.Left="15"
                           Canvas.Top="20" />
                <Rectangle Width="75"
                           Height="190"
                           Fill="#FAEFD3"
                           RadiusX="8"
                           RadiusY="8"
                           Canvas.Left="15"
                           Canvas.Top="20" />
            </Canvas>

            <Canvas>
                <Border Background="White"
                        Height="132"
                        Width="10"
                        Canvas.Left="45"
                        Canvas.Top="42">
                </Border>
                <Border x:Name="DisplayHeightBorder"
                        Background="#C3554E"
                        Height="50"
                        Width="10"
                        VerticalAlignment="Bottom"
                        Canvas.Left="45"
                        Canvas.Bottom="50" />

                <Ellipse Width="25"
                         Height="25"
                         Fill="#C3554E"
                         Canvas.Left="38"
                         Canvas.Top="164" />
                <Ellipse Width="10"
                         Height="10"
                         Fill="#EC6B5C"
                         Canvas.Left="43"
                         Canvas.Top="169" />
            </Canvas>

            <!--刻度-->
            <Canvas x:Name="TickBorder"
                    Margin="55,43,20,60">

            </Canvas>

        </Grid>
    </Viewbox>
</UserControl>
