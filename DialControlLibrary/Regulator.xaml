<UserControl x:Class="DialControlLibrary.Regulator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DialControlLibrary"
             xmlns:SCL="clr-namespace:SingleCntroLibrary.Controls;assembly=SingleCntroLibrary"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/SingleCntroLibrary;component/Styles/Generic.xaml" />
    </UserControl.Resources>
    <Viewbox Stretch="Uniform">
        <Grid Width="110"
              Height="120">
            <Border Background="Transparent" />
            <Canvas>
                <SCL:RegLable Content="Maximun"
                              Canvas.Left="7"
                              Canvas.Top="1"
                              Style="{StaticResource RegLabelStyle}" />
                <SCL:RegTextBox Style="{StaticResource RegTextBoxStyle}"
                                Text="{Binding MaxInput, 
                        RelativeSource={RelativeSource Mode=FindAncestor,
                        AncestorType=local:Regulator},
                        UpdateSourceTrigger=PropertyChanged}"
                                x:Name="MaxTextBox"
                                HorizontalAlignment="Center"
                                Canvas.Top="21"
                                VerticalAlignment="Top"
                                Canvas.Left="5" />
                <SCL:RegLable Content="Minimun"
                              Canvas.Left="7"
                              Canvas.Top="39"
                              Style="{StaticResource RegLabelStyle}" />
                <SCL:RegTextBox Style="{StaticResource RegTextBoxStyle}"
                                Text="{Binding MinInput, 
                 RelativeSource={RelativeSource Mode=FindAncestor,
                 AncestorType=local:Regulator},
                 UpdateSourceTrigger=PropertyChanged}"
                                HorizontalAlignment="Center"
                                Canvas.Top="59"
                                x:Name="MinTextBox"
                                VerticalAlignment="Top"
                                Canvas.Left="5"/>
                <SCL:RegLable Content="Value"
                              Canvas.Left="9"
                              Canvas.Top="77"
                              Style="{StaticResource RegLabelStyle}" />
                <SCL:RegTextBox Style="{StaticResource RegTextBoxStyle}"
                                Text="{Binding NumOutput, 
                  RelativeSource={RelativeSource Mode=FindAncestor,
                  AncestorType=local:Regulator},
                  UpdateSourceTrigger=PropertyChanged}"
                                HorizontalAlignment="Center"
                                Canvas.Top="97"
                                x:Name="ValueTextBox"
                                VerticalAlignment="Top"
                                Canvas.Left="5" />
            </Canvas>

        </Grid>
    </Viewbox>
</UserControl>
