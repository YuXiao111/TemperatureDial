<Window x:Class="TemperatureDial.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TemperatureDial"
        mc:Ignorable="d"
        xmlns:DCL="clr-namespace:DialControlLibrary;assembly=DialControlLibrary"
        xmlns:SCL="clr-namespace:SingleCntroLibrary.Controls;assembly=SingleCntroLibrary"
        Title="MainWindow"
        Height="600"
        Width="560"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/SingleCntroLibrary;component/Styles/Generic.xaml" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="9*" />
        </Grid.RowDefinitions>
     
        <Border CornerRadius="10"
                Grid.RowSpan="2">
            <Border.Background>
                <LinearGradientBrush>
                    <GradientStop Color="#BDD7EE"
                                  Offset="1" />
                    <GradientStop Color="White"
                                  Offset="0.56" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Canvas>
            <SCL:RegLable Content="Industrial Temperature Console"
                          FontSize="27"
                          Margin="18,25,0,0"
                          Style="{StaticResource RegLabelStyle}" />
        </Canvas>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <DCL:MercuryThermometer MaxiMun="50"
                                    Minimun="-20"
                                    DisplayValue="25"
                                    Width="240" />
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*" />
                    <RowDefinition Height="6*" />
                </Grid.RowDefinitions>

                <DCL:Indicator Width="200"
                                Grid.Row="0" />
                <DCL:Regulator Height="279"
                               Width="240"
                               Grid.Row="1"
                               x:Name="Reg"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Canvas.Left="10"
                               Canvas.Top="10" />
            </Grid>
        </Grid>
    </Grid>
</Window>
